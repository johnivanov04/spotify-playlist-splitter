# Copy to server/.env and fill in your own values. Never commit the real file.

# --- Spotify OAuth ---------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard to get these.
# The redirect URI must also be registered in the Spotify dashboard.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/auth/callback

# Where the server redirects after a successful login, and the origin
# allowed through CORS.
FRONTEND_URL=http://127.0.0.1:5173

# --- Session ---------------------------------------------------------
# Signing key for the session cookie. Use a long random string, and use a
# different one in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-long-random-string

# --- Database --------------------------------------------------------
# PostgreSQL connection string (this project uses Neon).
DATABASE_URL=postgresql://user:password@host/dbname

# --- LLM provider ----------------------------------------------------
# Required for playlist analysis. Without it, /api/vibes/analyze returns 503
# and the rest of the app still works.
ANTHROPIC_API_KEY=your-api-key

# --- Optional --------------------------------------------------------
# Used only by the dormant MusicBrainz enrichment endpoint.
# Format: AppName/version (contact@example.com)
MUSICBRAINZ_USER_AGENT=PlaylistSplitter/1.0 (you@example.com)

# Port to listen on. Defaults to 4000. Hosting providers usually set this.
PORT=4000

# Set to "production" when deployed. Enables trust proxy, secure cookies,
# request logging, and serving the built client from client/dist.
NODE_ENV=
